{
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "i18next": "^25.6.3"
  },
  "devDependencies": {
    "glob": "^10.3.10"
  },
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "snapshot": "node scripts/build-site-snapshot.js",
    "snapshot:site": "node scripts/build-site-snapshot.js",
    "snapshot:offline": "node scripts/build-site-snapshot.js --from-github-snapshot",
    "start": "node scripts/dev-server.js",
    "dev:vercel": "vercel dev",
    "extract-translations": "node scripts/extract-translations.js",
    "i18n:extract": "node scripts/extract-translations.js",
    "i18n:sync": "node scripts/extract-translations.js",
    "i18n:translate": "node scripts/extract-translations.js --auto-translate",
    "i18n:translate-missing": "node scripts/extract-translations.js --translate-missing"
  }
}
